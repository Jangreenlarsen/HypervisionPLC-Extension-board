{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard origin*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard origin*)",
      "PowerShell(Remove-Item -Recurse -Force*)"
    ],
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(pio test*)",
      "Bash(pio run*)",
      "Bash(pio check*)",
      "Bash(pio device monitor*)",
      "Bash(platformio test*)",
      "Bash(platformio run*)",
      "Bash(platformio check*)",
      "PowerShell(pio test*)",
      "PowerShell(pio run*)",
      "PowerShell(pio check*)",
      "PowerShell(pio device monitor*)",
      "PowerShell(platformio test*)",
      "PowerShell(platformio run*)",
      "PowerShell(platformio check*)"
    ]
  }
}
